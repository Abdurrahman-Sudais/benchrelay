{
  "_comment": "Shared readiness fixtures. src/app/engine.test.js (prototype) and backend/tests/test_lambdas.py (Lambda) must both produce these statuses and finding kinds.",
  "context": { "transferDate": "2026-11-16", "marginDays": 30 },
  "cases": [
    { "name": "at least: meets", "req": { "kind": "atLeast", "parameter": "maxTemp", "required": { "value": 180, "unit": "°C" } }, "eq": { "capabilities": { "maxTemp": { "value": 250, "unit": "°C" } } }, "status": "Meets requirement", "kinds": [] },
    { "name": "at least: equal is enough", "req": { "kind": "atLeast", "parameter": "maxTemp", "required": { "value": 180, "unit": "°C" } }, "eq": { "capabilities": { "maxTemp": { "value": 180, "unit": "°C" } } }, "status": "Meets requirement", "kinds": [] },
    { "name": "at least: mismatch", "req": { "kind": "atLeast", "parameter": "maxTemp", "required": { "value": 180, "unit": "°C" } }, "eq": { "capabilities": { "maxTemp": { "value": 150, "unit": "°C" } } }, "status": "Capability mismatch", "kinds": ["Capability mismatch"] },
    { "name": "at most with unit conversion: 10 µm equals 0.01 mm", "req": { "kind": "atMost", "parameter": "resolution", "required": { "value": 0.01, "unit": "mm" } }, "eq": { "capabilities": { "resolution": { "value": 10, "unit": "µm" } } }, "status": "Meets requirement", "kinds": [] },
    { "name": "at most: coarser resolution", "req": { "kind": "atMost", "parameter": "resolution", "required": { "value": 0.01, "unit": "mm" } }, "eq": { "capabilities": { "resolution": { "value": 20, "unit": "µm" } } }, "status": "Capability mismatch", "kinds": ["Capability mismatch"] },
    { "name": "time conversion: 500 ms is finer than 1 s", "req": { "kind": "atMost", "parameter": "resolution", "required": { "value": 1, "unit": "s" } }, "eq": { "capabilities": { "resolution": { "value": 500, "unit": "ms" } } }, "status": "Meets requirement", "kinds": [] },
    { "name": "mass conversion: 0.0001 g equals 0.1 mg", "req": { "kind": "atMost", "parameter": "resolution", "required": { "value": 0.1, "unit": "mg" } }, "eq": { "capabilities": { "resolution": { "value": 0.0001, "unit": "g" } } }, "status": "Meets requirement", "kinds": [] },
    { "name": "different dimensions never compare", "req": { "kind": "atMost", "parameter": "resolution", "required": { "value": 1, "unit": "s" } }, "eq": { "capabilities": { "resolution": { "value": 0.01, "unit": "mm" } } }, "status": "Capability mismatch", "kinds": ["Unit mismatch"] },
    { "name": "value not recorded", "req": { "kind": "atMost", "parameter": "resolution", "required": { "value": 0.01, "unit": "mm" } }, "eq": { "capabilities": {} }, "status": "Capability unknown", "kinds": ["Capability unknown"] },
    { "name": "no equipment", "req": { "kind": "atMost", "parameter": "resolution", "required": { "value": 1, "unit": "s" } }, "eq": null, "status": "No equipment mapped", "kinds": ["No equipment mapped"] },
    { "name": "record: valid past margin", "req": { "kind": "record" }, "eq": { "capabilities": {}, "calibration": { "ref": "C", "date": "2026-01-01", "due": "2026-12-16" } }, "status": "Meets requirement", "kinds": [] },
    { "name": "record: due a day before the margin ends", "req": { "kind": "record" }, "eq": { "capabilities": {}, "calibration": { "ref": "C", "date": "2026-01-01", "due": "2026-12-15" } }, "status": "Calibration issue", "kinds": ["Calibration due too soon"] },
    { "name": "record: missing", "req": { "kind": "record" }, "eq": { "capabilities": {}, "calibration": null }, "status": "Calibration issue", "kinds": ["Calibration record missing"] },
    { "name": "calibrated capability: value fine, calibration missing", "req": { "kind": "atLeast", "parameter": "maxTemp", "required": { "value": 180, "unit": "°C" }, "calibrated": true }, "eq": { "capabilities": { "maxTemp": { "value": 200, "unit": "°C" } }, "calibration": null }, "status": "Calibration issue", "kinds": ["Calibration record missing"] },
    { "name": "mismatch outranks calibration", "req": { "kind": "atLeast", "parameter": "maxTemp", "required": { "value": 180, "unit": "°C" }, "calibrated": true }, "eq": { "capabilities": { "maxTemp": { "value": 150, "unit": "°C" } }, "calibration": null }, "status": "Capability mismatch", "kinds": ["Capability mismatch", "Calibration record missing"] },
    { "name": "unknown value with calibration problem shows calibration", "req": { "kind": "atMost", "parameter": "resolution", "required": { "value": 1, "unit": "%RH" }, "calibrated": true }, "eq": { "capabilities": {}, "calibration": { "ref": "C", "date": "2025-01-01", "due": "2026-11-20" } }, "status": "Calibration issue", "kinds": ["Capability unknown", "Calibration due too soon"] }
  ]
}
